# ============================================
# CoopElos - Variaveis de Ambiente (Producao)
# Preencha ANTES de fazer deploy via Dokploy
# ============================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_AQUI
POSTGRES_DB=coopelos

# --- Redis ---
# Nao precisa de senha para Redis interno

# --- Auth (iron-session) ---
# Minimo 32 caracteres! Gerar com: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS

# --- App URL (dominio publico com https) ---
APP_URL=https://SEU_DOMINIO.com.br

# --- Backend (NestJS) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_TOKEN_64_HEX_CHARS

# --- AWS S3 (documentos) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_S3_BUCKET=coopelos-documents
