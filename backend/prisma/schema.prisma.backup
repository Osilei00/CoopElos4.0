generator client {  provider = "prisma-client-js"}datasource db {  provider = "postgresql"}/// Multi-tenant cooperativemodel Cooperative {  id                   String                 @id @default(uuid())  name                 String  cnpj                 String?                @unique  logo_url             String?  address              String?  phone                String?  email                String?  created_at           DateTime               @default(now())  updated_at           DateTime               @updatedAt  audit_logs           AuditLog[]  ficha_cooperado_form AdhesionForm[]  patients             Patient[]  payrolls             Payroll[]  tasks                Task[]  users                User[]  cooperados           Cooperado[]  timeSheetHospitals   TimeSheetHospital[]  timeSheetSads        TimeSheetSad[]  vacations            Vacation[]  @@map("cooperative")}/// System users (admin, rh, dp, viewer)model User {  id             String     @id @default(uuid())  name           String  email          String     @unique  password_hash  String  role           UserRole   @default(viewer)  is_active      Boolean    @default(true)  last_login     DateTime?  created_at     DateTime   @default(now())  updated_at     DateTime   @updatedAt  username       String?    @unique  cooperative_id String  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  audit_logs     AuditLog[]  assigned_tasks Task[]     @relation("TaskAssignee")  created_tasks  Task[]     @relation("TaskCreator")  @@map("user")}model Payroll {  id              String        @id @default(uuid())  cooperative_id  String  year            Int  month           Int  status          PayrollStatus @default(draft)  total_gross     Decimal       @default(0) @db.Decimal(12, 2)  total_discounts Decimal       @default(0) @db.Decimal(12, 2)  total_net       Decimal       @default(0) @db.Decimal(12, 2)  closed_at       DateTime?  created_at      DateTime      @default(now())  updated_at      DateTime      @updatedAt  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  @@unique([cooperative_id, year, month])  @@map("payroll")}model Patient {  id             String      @id @default(uuid())  cooperative_id String  name           String  code           String?  created_at     DateTime    @default(now())  updated_at     DateTime    @updatedAt  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  timeSheetSads TimeSheetSad[]  @@map("patient")}model Task {  id             String      @id @default(uuid())  cooperative_id String  title          String  description    String?  status         TaskStatus  @default(pending)  priority       Int         @default(0)  due_date       DateTime?  completed_at   DateTime?  creator_id     String  assignee_id    String?  created_at     DateTime    @default(now())  updated_at     DateTime    @updatedAt  assignee       User?       @relation("TaskAssignee", fields: [assignee_id], references: [id])  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  creator        User        @relation("TaskCreator", fields: [creator_id], references: [id])  @@index([cooperative_id, status, due_date])  @@map("task")}model AuditLog {  id             String      @id @default(uuid())  cooperative_id String  user_id        String?  action         String  table_name     String  record_id      String  old_data       Json?  new_data       Json?  ip_address     String?  user_agent     String?  created_at     DateTime    @default(now())  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  user           User?       @relation(fields: [user_id], references: [id])  @@index([cooperative_id, created_at])  @@map("audit_log")}model Document {  id            String   @id @default(uuid())  cooperado_id  String  name         String  file_key     String  mime_type    String  file_size    Int  file_url      String?  created_at    DateTime @default(now())    cooperado     Cooperado @relation(fields: [cooperado_id], references: [id])    @@index([cooperado_id])  @@map("document")}model Cooperado {  id              String            @id @default(uuid())  cooperative_id  String  cooperado_number Int  status          String            @default("active")    // Personal data  nome_cooperado  String?  cpf_cooperado   String?           @unique  rg              String?  nis_pis         String?  ctps_serie      String?  nacionalidade   String?  naturalidade    String?  nascimento      DateTime?  sexo            String?  estado_civil    String?  escolaridade    String?  nome_pai        String?  nome_mae        String?  nome_conjuge    String?  cpf_conjuge     String?    // Contact data  celular_cooperado    String?  telefone_residencial  String?  email_cooperado       String?  celular_indicador     String?  email_indicador       String?  nome_indicacao        String?  email_gestor          String?    // Address  endereco       String?  bairro         String?  complemento    String?  cep            String?  cidade         String?  estado         String?    // Professional data  empresa_trabalho    String?  cargo_pretendido    String?  cargo_contratado    String?  salario             String?  data_admissao       DateTime?  data_cadastro       DateTime?    // Activities  ativ_coop_dropa              String?  ativ_coop_dropb              String?  atividades_cooperados        String?  outras_ativd_profissionais   String?    // Banking  banco           String?  agencia         String?  conta_corrente  String?  pix             String?  capital_social  String?    // Documents  carteira_registro          String?  atestados_tecnicos        String?  curriculo_profissional     String?  descricao_sucinta          String?    // Financial  valor_acumulado   String?  valor_atual       String?  valor_integralizado String?  valor_var         String?  parcelas          String?  em_aberto         String?    // Others  local_cadastro   String?  imagem_cooperado String?  venc_cooperados  String?  matricula        String?  unique_id_bubble String?  @unique  slug             String?  creation_date    DateTime?  modified_date    DateTime?  creator          String?    created_at  DateTime  @default(now())  updated_at  DateTime  @updatedAt    cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  adhesion_form   AdhesionForm?  documents      Document[]  payrollItems   PayrollItem[] @relation("CooperadoPayrollItems")  vacations     Vacation[]    @@index([cooperative_id, cpf_cooperado])  @@map("cooperado")}model collaborator {  id        String  @id  full_name String  cpf       String  @unique  cel       String?  email     String?}model AdhesionForm {  id                         String      @id  cooperative_id             String  venc_cooperados            String?  matricula                  String?  unique_id_bubble           String?     @unique  slug                       String?  nome_cooperado             String?  cpf_cooperado              String?  rg                         String?  nis_pis                    String?  ctps_serie                 String?  nacionalidade              String?  naturalidade               String?  nascimento                 DateTime?  sexo                       String?  estado_civil               String?  escolaridade               String?  nome_pai                   String?  nome_mae                   String?  nome_conjuge               String?  cpf_conjuge                String?  celular_cooperado          String?  telefone_residencial       String?  email_cooperado            String?  celular_indicador          String?  email_indicador            String?  nome_indicacao             String?  email_gestor               String?  endereco                   String?  bairro                     String?  complemento                String?  cep                        String?  cidade                     String?  estado                     String?  empresa_trabalho           String?  cargo_pretendido           String?  cargo_contratado           String?  salario                    String?  data_admissao              DateTime?  data_cadastro              DateTime?  ativ_coop_dropa            String?  ativ_coop_dropb            String?  atividades_cooperados      String?  outras_ativd_profissionais String?  banco                      String?  agencia                    String?  conta_corrente             String?  pix                        String?  capital_social             String?  carteira_registro          String?  atestados_tecnicos         String?  curriculo_profissional     String?  descricao_sucinta          String?  valor_acumulado            String?  valor_atual                String?  valor_integralizado        String?  valor_var                  String?  parcelas                   String?  em_aberto                  String?  local_cadastro             String?  imagem_cooperado           String?  creation_date              DateTime?  modified_date              DateTime?  creator                    String?  created_at                 DateTime    @default(now())  updated_at                 DateTime  cooperative                Cooperative @relation(fields: [cooperative_id], references: [id])  cooperado_id               String?   @unique  cooperado                  Cooperado?   @relation(fields: [cooperado_id], references: [id])  @@index([cooperative_id, cpf_cooperado])}enum UserRole {  admin  rh  dp  viewer}enum TaskStatus {  pending  in_progress  completed  overdue}enum PayrollStatus {  draft  processing  closed  cancelled}enum CollaboratorStatus {  active  inactive  suspended}enum Gender {  masculine  feminine}enum MaritalStatus {  single  married  divorced  widowed  other}model TimeSheetHospital {  id              String   @id @default(uuid())  cooperative_id  String  month          Int  year           Int  data           Json  created_at      DateTime @default(now())  updated_at      DateTime @updatedAt  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  @@index([cooperative_id, year, month])  @@map("time_sheet_hospital")}model TimeSheetSad {  id              String   @id @default(uuid())  cooperative_id  String  patient_id     String  professional_id String  month          Int  year           Int  data           Json  created_at      DateTime @default(now())  updated_at      DateTime @updatedAt  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  patient       Patient     @relation(fields: [patient_id], references: [id])  @@index([cooperative_id, year, month])  @@map("time_sheet_sad")}model Vacation {  id              String   @id @default(uuid())  cooperative_id  String  cooperado_id   String  start_date     DateTime  end_date       DateTime  days_count     Int  status          String   @default("pending")  created_at      DateTime @default(now())  updated_at      DateTime @updatedAt  cooperative    Cooperative @relation(fields: [cooperative_id], references: [id])  cooperado     Cooperado   @relation(fields: [cooperado_id], references: [id])  @@index([cooperative_id, cooperado_id])  @@map("vacation")}model PayrollItem {  id              String   @id @default(uuid())  payroll_id      String  cooperado_id   String  gross_amount    Decimal  @default(0) @db.Decimal(12, 2)  discounts       Decimal  @default(0) @db.Decimal(12, 2)  net_amount      Decimal  @default(0) @db.Decimal(12, 2)  created_at      DateTime @default(now())  updated_at      DateTime @updatedAt  payroll        Payroll   @relation("PayrollItems", fields: [payroll_id], references: [id])  cooperado     Cooperado @relation("CooperadoPayrollItems", fields: [cooperado_id], references: [id])  @@index([payroll_id])  @@map("payroll_item")}