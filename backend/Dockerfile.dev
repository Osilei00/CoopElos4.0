# Development stage
FROM node:20

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/
COPY prisma.config.ts ./

# Install ALL dependencies (including dev)
RUN npm ci

# Copy source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Use root for dev mode (simpler, no chown needed)
EXPOSE 3001

# Start in dev mode
CMD ["npx", "ts-node-dev", "--respawn", "--transpile-only", "src/main.ts"]
