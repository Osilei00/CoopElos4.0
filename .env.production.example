# ============================================
# CoopElos - Producao (Oracle Cloud)
# Copie para .env.production e preencha
# ============================================

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis (senha opcional, descomente se usar) ---
# REDIS_PASSWORD=CHANGE_ME

# --- Session ---
SESSION_SECRET=CHANGE_ME_TO_32_CHARS_MINIMUM
INTERNAL_API_TOKEN=CHANGE_ME_TO_64_CHAR_HEX

# --- URLs ---
APP_URL=https://seu-dominio.com.br

# --- AWS S3 (Oracle Cloud Object Storage alternatives abaixo) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_BUCKET_NAME=coopelos-documents

# --- Oracle Cloud Object Storage (alternativa ao S3) ---
# Usar variaveis OCI em vez das AWS se preferir Object Storage nativo
# OCI_CONFIG_FILE=/home/opc/.oci/config
# OS_NAMESPACE=seu_namespace
# OS_BUCKET=coopelos-documents
